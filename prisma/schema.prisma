generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Merchant model replaces BrandConfig - represents a single merchant/tenant
/// All branding, configuration, and integration settings are stored here
model Merchant {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  name                 String
  brandName            String
  primaryColor         String                @default("#e11d48")
  accentColor          String                @default("#f97373")
  backgroundColor      String                @default("#ffffff")
  surfaceColor         String                @default("#fff7f7")
  borderColor          String                @default("#ffe4e6")
  logoUrl              String?
  voiceInstructions    String
  toneFormal           Int
  tonePlayful          Int
  useMerchantKey       Boolean               @default(false)
  merchantOpenAIKey    String?
  datasetContext       Json?
  shopifyStore         String?
  shopifyAccessToken   String?
  shopifySyncEnabled   Boolean               @default(false)
  shopifySyncedAt      DateTime?
  reviewProvider       String?
  reviewApiKey         String?
  reviewSyncEnabled    Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  uiCopy               Json?
  faq                  Json?
  analyticsEvents      AnalyticsEvent[]
  apiKeys              ApiKey[]
  catalogIngestionRuns CatalogIngestionRun[]
  conversationEvents   ConversationEvent[]
  conversationStates   ConversationState[]
  merchRules           MerchRule[]
  users                MerchantUser[]
  products             Product[]
  reviewConfig         ReviewConfig?

  @@index([slug])
  @@index([createdAt])
}

/// Merchant user accounts for authentication and authorization
/// Supports role-based access control (ADMIN, EDITOR, VIEWER)
model MerchantUser {
  id           String    @id @default(cuid())
  merchantId   String
  email        String
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, email])
  @@index([merchantId])
  @@index([email])
}

/// API keys for widget embedding and public API access
/// Each key has allowed origins for CORS validation
model ApiKey {
  id             String   @id @default(cuid())
  merchantId     String
  name           String
  token          String   @unique
  allowedOrigins String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([token])
}

/// Review platform configuration and sync settings
/// One-to-one relationship with Merchant
model ReviewConfig {
  id                 String         @id @default(cuid())
  merchantId         String         @unique
  provider           ReviewProvider
  businessId         String
  apiKey             String
  apiUrl             String?
  companyReviewScore Float?
  companyReviewCount Int?
  syncEnabled        Boolean        @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  merchant           Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

/// Product model - now multi-tenant with merchantId
/// Extended with Shopify and review integration fields
/// Phase 2: Added indexed columns for commonly-queried attributes (color, fabric, etc.)
/// Phase 2: Added variants relation for ProductVariant model
model Product {
  /// Core product data. All flexible / vendor-specific attributes must be stored
  /// in the JSON `attributes` field (e.g. "new", "is_featured", custom tags).
  /// Do NOT add ad-hoc columns such as `new` – those belong in `attributes`.
  id                  String                   @id
  merchantId          String
  title               String
  description         String
  imageUrl            String
  priceCents          Int
  currency            String
  category            String
  subcategory         String?
  brand               String?
  attributes          Json
  stockStatus         StockStatus              @default(in_stock)
  vendorId            String?
  sourceId            String?
  isActive            Boolean                  @default(true)
  lastIngestBatchId   String?
  shopifyProductId    String?
  shopifyHandle       String?
  shopifyVariantIds   String[]
  shopifyBestseller   Boolean                  @default(false)
  shopifyTrending     Boolean                  @default(false)
  shopifySalesRank    Int?
  reviewScore         Float?
  reviewCount         Int?
  reviewsJson         Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  productUrl          String
  salePriceCents      Int?
  search_vector       Unsupported("tsvector")?
  embedding           Unsupported("vector")?
  color               String?
  fabric              String?
  material            String?
  occasion            String?
  season              String?
  fit                 String?
  silhouetteCut       String?
  length              String?
  sleeve              String?
  neckline            String?
  closureConstruction String?
  lined               Boolean?
  fitPreference       String?
  riseWaist           String?
  stretchLevel        String?
  bodyIntent          String?
  comfortIntent       String?
  fabricFamily        String?
  handfeel            String?
  warmthWeight        String?
  breathability       String?
  opacity             String?
  wrinkleBehavior     String?
  formalityLevel      String?
  occasionContext     String[]
  dressCode           String?
  seasonalCues        String?
  temperatureIntent   String?
  humidityFriendly    Boolean?
  movementNeeds       String?
  problemSolutions    String[]
  functionFeatures    String[]
  colorShade          String?
  colorUndertone      String?
  multicolor          Boolean?
  seasonalPalette     String?
  inclusivitySizing   String?
  ageGroup            String?
  enrichedColor       String?
  gender              String?
  merchant            Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([merchantId, category])
  @@index([merchantId, stockStatus])
  @@index([merchantId, isActive])
  @@index([category])
  @@index([stockStatus])
  @@index([shopifyProductId])
  @@index([shopifyBestseller])
  @@index([shopifyTrending])
  @@index([vendorId, isActive])
  @@index([vendorId, sourceId])
  @@index([embedding], map: "idx_product_embedding")
  @@index([search_vector], map: "idx_product_search", type: Gin)
  @@index([gender], map: "idx_product_gender")
  @@index([silhouetteCut], map: "idx_product_silhouette_cut")
  @@index([length], map: "idx_product_length")
  @@index([sleeve], map: "idx_product_sleeve")
  @@index([neckline], map: "idx_product_neckline")
  @@index([formalityLevel], map: "idx_product_formality_level")
  @@index([temperatureIntent], map: "idx_product_temperature_intent")
  @@index([humidityFriendly], map: "idx_product_humidity_friendly")
  @@index([colorShade], map: "idx_product_color_shade")
  @@index([colorUndertone], map: "idx_product_color_undertone")
  @@index([multicolor], map: "idx_product_multicolor")
  @@index([enrichedColor], map: "idx_product_enriched_color")
  @@index([ageGroup], map: "idx_product_age_group")
  @@index([category, subcategory], map: "idx_product_category_subcategory")
  @@index([occasionContext], map: "idx_product_occasion_context", type: Gin)
  @@index([problemSolutions], map: "idx_product_problem_solutions", type: Gin)
  @@index([functionFeatures], map: "idx_product_function_features", type: Gin)
  @@index([category, length, formalityLevel], map: "idx_product_category_length_formality")
  @@index([temperatureIntent, humidityFriendly], map: "idx_product_temperature_humidity")
  @@index([bodyIntent, comfortIntent], map: "idx_product_body_comfort")
  @@index([colorShade, colorUndertone], map: "idx_product_shade_undertone")
}

/// Catalog ingestion tracking - now multi-tenant
model CatalogIngestionRun {
  id          String        @id
  merchantId  String
  vendorId    String
  createdAt   DateTime      @default(now())
  totalRows   Int
  inserted    Int
  updated     Int
  invalidRows Int           @default(0)
  deactivated Int?
  mode        IngestionMode
  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([createdAt])
  @@index([vendorId, createdAt])
}

/// Merchandising rules - now multi-tenant
/// Rules for boosting/excluding categories, hiding out-of-stock items
model MerchRule {
  id         Int           @id @default(autoincrement())
  merchantId String
  ruleType   MerchRuleType
  value      String
  weight     Int           @default(0)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([merchantId, ruleType])
  @@index([merchantId, isActive])
}

/// Analytics events for behavior tracking - NEW model
/// Tracks user interactions, product views, clicks, etc.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  merchantId  String
  sessionId   String
  eventType   String
  payload     Json
  userDevice  String?
  userPage    String?
  userReferer String?
  createdAt   DateTime @default(now())
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([merchantId, eventType])
  @@index([sessionId])
  @@index([createdAt])
}

/// Conversation events - now multi-tenant
/// Legacy model for conversation tracking (may be merged with AnalyticsEvent later)
model ConversationEvent {
  id                    String   @id
  merchantId            String
  sessionId             String
  pageType              PageType
  productContextId      String?
  userQuery             String   @db.VarChar(256)
  productIds            String[]
  hadExactMatch         Boolean  @default(false)
  clickedProductId      String?
  createdAt             DateTime @default(now())
  assistantReplySnippet String?  @db.VarChar(256)
  clicked               Boolean  @default(false)
  route                 String?
  actionType            String?
  hadActionClick        Boolean  @default(false)
  hadTypedYesNo         Boolean  @default(false)
  merchant              Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([merchantId, createdAt])
  @@index([createdAt])
  @@index([sessionId])
}

/// Conversation state - persistent state per (merchantId, sessionId)
/// Supports: shown products, ranked list cursor, pending actions, preferences memory
model ConversationState {
  id                   String   @id @default(cuid())
  merchantId           String
  sessionId            String
  shownProductIds      String[]
  lastQueryFingerprint String?
  lastRankedProductIds String[]
  lastRankCursor       Int      @default(0)
  pendingActions       Json     @default("[]")
  memory               Json     @default("{}")
  updatedAt            DateTime @updatedAt
  merchant             Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, sessionId])
  @@index([merchantId])
  @@index([merchantId, sessionId])
  @@index([sessionId])
  @@index([updatedAt])
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum ReviewProvider {
  TRUSTPILOT
  REVIEWS_IO
  YOTPO
  SITEJABBER
  CUSTOM
}

enum IngestionMode {
  FULL_REPLACE
  INCREMENTAL
}

enum MerchRuleType {
  boost_category
  exclude_category
  hide_out_of_stock
}

enum PageType {
  HOME
  PLP
  PDP
}

enum StockStatus {
  in_stock
  out_of_stock
  low_stock
}
